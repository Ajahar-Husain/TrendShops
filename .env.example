# Server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/trendshops
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-with-a-different-random-secret-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Demo UPI (replace with your UPI VPA if testing a real transfer)
DEMO_UPI_VPA=trendshops-demo@upi
DEMO_UPI_NAME=TrendShops Demo

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=TrendShops <noreply@trendshops.in>
CLIENT_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@trendshops.in
SEED_ADMIN_PASSWORD=

# WhatsApp (optional - Twilio or similar)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client
VITE_API_URL=http://localhost:5000

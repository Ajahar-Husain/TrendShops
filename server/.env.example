# ───────────────────────────────────────────
# TrendShops Server — Environment Variables
# ───────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/trendshops

# JWT
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-this-with-a-different-random-secret-32-chars_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# UPI merchant details (QR transfers may be real; admins must verify manually)
MERCHANT_UPI_VPA=trendshops-demo@upi
MERCHANT_UPI_NAME=TrendShops

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@trendshops.in
SMTP_PASS=your_app_password_here
EMAIL_FROM=TrendShops <noreply@trendshops.in>

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Optional seed administrator (required by npm run seed to create an admin)
SEED_ADMIN_EMAIL=admin@trendshops.in
SEED_ADMIN_PASSWORD=

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

